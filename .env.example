# Copy to .env for local development. In production set these in your host (Vercel / Cloud Run) instead.

# Database. Local: SQLite file. Production: any Postgres connection string (Neon, Supabase, Google Cloud SQL...).
# The schema's provider is chosen automatically from this value (scripts/prisma-provider.mjs).
DATABASE_URL="file:./dev.db"

# Signs login cookies. Use a long random string in production (e.g. `openssl rand -hex 32`).
SESSION_SECRET="change-me"

# Public address of the site, used in emails and the calendar link given to Airbnb.
SITE_URL="http://localhost:3000"

# The owner login created by the seed, and where "new booking" emails go.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"
OWNER_EMAIL="owner@example.com"

# Payments (leave empty to use the built-in demo payment page).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email (leave empty to store messages in Admin -> Notifications instead of sending).
RESEND_API_KEY=""
MAIL_FROM="La Bastide de Lestrebaldie <hello@example.com>"

# Calendar sync: "ical" (free) or "beds24". CRON_SECRET protects /api/cron/sync.
CHANNEL_PROVIDER="ical"
CRON_SECRET="change-me"

# Instant sync through Beds24 (only with CHANNEL_PROVIDER="beds24"; see README "Instant sync with Beds24").
BEDS24_REFRESH_TOKEN=""
BEDS24_WEBHOOK_SECRET=""

# Image uploads in production (set automatically when you add a Vercel Blob store). Empty = local public/uploads.
BLOB_READ_WRITE_TOKEN=""
